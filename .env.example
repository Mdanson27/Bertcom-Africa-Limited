# ==============================================================================
# Bertcom Africa Business Os — Environment Example Template
# ==============================================================================

# ── Runtime & Security ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=bertcom-africa-business-os
ENVIRONMENT=development
DEBUG=True
APP_NAME="Bertcom Africa Business Os"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# ── Database Infrastructure (PostgreSQL 16 / TimescaleDB) ──────────────────────
POSTGRES_USER=bertcom_user
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=bertcom_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bertcom_user:change_this_to_a_secure_postgres_password@postgres-db:5432/bertcom_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache Engine (Valkey) ─────────────────────────────────────────────────────

VALKEY_HOST=valkey-cache
VALKEY_PORT=6379


# ── Initial Platform Superuser ────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=ddaannson@gmail.com
FIRST_SUPERUSER_PASSWORD="Zimbarent@2026"
FIRST_SUPERUSER_NAME="AUTOMINDS AFRICA"

# ── API Documentation & Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
DOCS_UI=scalar

# ── Sentry Observability (APM & Error Tracking) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Cloudflare Zero Trust Edge Tunnel ─────────────────────────────────────────

CLOUDFLARED_TUNNEL_TOKEN=


# ── SMTP Email Dispatch (Optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_ADDRESS=noreply@platform.internal
EMAILS_FROM_NAME="Bertcom Africa Business Os"
